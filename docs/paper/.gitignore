# Build artifacts - keep out of git and out of the paper-root directory.
# The Makefile writes the canonical PDF to ../../output/pdf/ and removes
# its intermediates. These patterns also cover accidental direct builds.

# LaTeX run artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Accidental root-level compiled output
main.pdf
