# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Raw data — too large, downloaded from public sources. Ignore raw archives
# anywhere under data/raw/ (including the data/raw/ root itself, not just the
# nhs/ and supporting/ subfolders) so manually-dropped downloads don't show up
# as untracked noise for collaborators.
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.zip
data/raw/*.csv
data/raw/nhs/*.xlsx
data/raw/nhs/*.zip
data/raw/nhs/*.csv
data/raw/supporting/*.xlsx
data/raw/supporting/*.xls
data/raw/supporting/*.csv
data/raw/supporting/*.zip

# Download manifests are regenerated locally by the download scripts —
# not version-controlled. Keep gitkeeps so the empty dirs persist.
data/raw/MANIFEST.txt
data/raw/nhs/MANIFEST.txt
data/raw/supporting/MANIFEST.txt
!data/raw/nhs/.gitkeep
!data/raw/supporting/.gitkeep

# Processed data — regeneratable from raw
data/processed/*.csv
data/processed/*.parquet
data/processed/*.feather
data/processed/*.md
!data/processed/.gitkeep
!data/processed/README.md

# Regenerated training log
results/forecasting/train_log.txt

# Results and figures are COMMITTED so headline tables/figures are available
# without re-running the heavy pipeline. Do not ignore results/ or figures/
# contents. (Bulky raw NHS data is still ignored above; large model
# checkpoints are ignored via *.pt/*.pth.)

# Local documents and build outputs
docs/
output/

# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Local secrets / API keys
.env
.env.local
*.key
secrets/

# Solver licences
gurobi.lic
